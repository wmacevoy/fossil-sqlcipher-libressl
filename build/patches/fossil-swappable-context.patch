+/* ---- swappable global context ---------------------------------------
+** Fossil keeps all process state in one `Global g`, which makes exactly one
+** repository openable per process. Reaching it through a pointer makes the
+** context selectable by an embedder at no cost to stock behaviour: every
+** `g.field` becomes `(*gp).field`, `&g` becomes `gp`, and `sizeof(g)`
+** becomes `sizeof(*gp)` -- all valid, all unchanged semantically. */
+struct Global;
+#if defined(_MSC_VER)
+# define FOSSIL_TLS __declspec(thread)
+#else
+# define FOSSIL_TLS _Thread_local
+#endif
+extern FOSSIL_TLS struct Global *gp;
+#define g (*gp)
diff --git a/src/main.c b/src/main.c
