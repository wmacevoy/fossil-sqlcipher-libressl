@@ -385,7 +385,24 @@ struct Global {
 
 #endif
 
-Global g;
+/* THE PROCESS-GLOBAL CONTEXT IS NOW REACHED THROUGH A POINTER.
+**
+** `g` is a macro for (*gp) -- see config.h -- so the line below reads to the
+** COMPILER as `Global (*gp);`, a tentative definition of the pointer, while
+** still reading to MKHEADERS as `Global g;`. That matters: mkheaders decides
+** which generated header needs `struct Global` by looking for files that use
+** the symbol `g`, so renaming this line out of existence silently stops the
+** struct from being emitted and every file fails with "incomplete type".
+** Measured, not guessed -- that was this patch's first attempt.
+**
+** fossil_context_init() below points gp at the default storage. It is called
+** from fossil_main() and must also be called by any embedder that opens a
+** repository WITHOUT going through fossil_main(). */
+FOSSIL_TLS Global g;   /* -> FOSSIL_TLS Global (*gp); one context PER THREAD */
+static FOSSIL_TLS Global g_default_context;
+void fossil_context_init(void){
+  if( gp==0 ) gp = &g_default_context;
+}
 
