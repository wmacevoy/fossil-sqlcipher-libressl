 NORETURN void fossil_fatal(const char *zFormat, ...){
-  static int once = 0;
   va_list ap;
   char *z;
   int rc = 1;
-  if( once ) exit(1);
-  once = 1;
+  /* fossil-see: route the reentrancy-guard bypass through fossil_exit(),
+  ** not a raw exit(1) -- db_close() still needs to run here, same class
+  ** of bug as every other unguarded exit()/abort() site. */
+  if( fossilFatalOnce ) fossil_exit(1);
+  fossilFatalOnce = 1;
   mainInFatalError = 1;
   va_start(ap, zFormat);
   z = vmprintf(zFormat, ap);
